# hw definition file for processing by chibios_hwdef.py

include common.inc

# Location where code will be placed
# must be the same as FLASH_BOOTLOADER_LOAD_KB
# in hwdef-bl.dat
FLASH_RESERVE_START_KB 128

define HAL_STORAGE_SIZE 32768

# store parameters in internal flash (sectors 14 and 15), no SD card or FRAM
# keep firmware and crash log out of the storage sectors (2 x 128 KB)
STORAGE_FLASH_PAGE 14

# disable ADC for now
define HAL_USE_ADC FALSE

# GPS (sensor board)
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# GPS (brain board)
#PB5 UART5_RX UART5
#PB6 UART5_TX UART5

# ESC1
PE7 UART7_RX UART7
PE8 UART7_TX UART7

# ESC2
PB14 USART1_TX USART1
PB15 USART1_RX USART1

# UART8 (expansion J14)
#PE0 UART8_RX UART8
#PE1 UART8_TX UART8

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART3 USART6 USART2 UART7 USART1
#            USB  DDS    MAV    GPS    ESC1  ESC2

# Ethernet
PA7  ETH_RMII_CRS_DV  ETH1
PA1  ETH_RMII_REF_CLK ETH1
PC1  ETH_MDC          ETH1
PA2  ETH_MDIO         ETH1
PC4  ETH_RMII_RXD0    ETH1
PC5  ETH_RMII_RXD1    ETH1
PB12 ETH_RMII_TXD0    ETH1
PB13 ETH_RMII_TXD1    ETH1
PB11 ETH_RMII_TX_EN   ETH1
PB2  Ethernet_NRST  OUTPUT HIGH

define BOARD_PHY_ID MII_LAN8742A_ID
define BOARD_PHY_RMII



# SPI1 (sensors)
PB3 SPI1_SCK  SPI1
PB4 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1
# MISO/MOSI are crossed on the PCB, swap them in the SPI peripheral (SPI_CFG2_IOSWP)
define HAL_SPI1_SWAP_IO 1

# SPI4 (expansion J13)
#PB10 SPI2_SCK  SPI2
#PC2  SPI2_MISO SPI2
#PC3  SPI2_MOSI SPI2

# SPI4 (expansion J16)
#PE2 SPI4_SCK  SPI4
#PE5 SPI4_MISO SPI4
#PE6 SPI4_MOSI SPI4

# I2C1 (expansion J15)
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

I2C_ORDER I2C1

SPIDEV icm40609 SPI1 DEVID1 IMU1_CS MODE3 4*MHZ 8*MHZ
SPIDEV bmi270   SPI1 DEVID1 IMU2_CS MODE3 4*MHZ 8*MHZ
SPIDEV bmp585   SPI1 DEVID1 BARO_CS MODE3 4*MHZ 8*MHZ
SPIDEV mmc5983  SPI1 DEVID1 MAGT_CS MODE3 4*MHZ 8*MHZ

define AP_BARO_BMP581_BMP585_MODE

IMU     Invensensev3 SPI:icm40609       ROTATION_YAW_270
IMU     BMI270       SPI:bmi270         ROTATION_YAW_180
COMPASS MMC5XX3      SPI:mmc5983  false ROTATION_NONE
BARO    BMP581       SPI:bmp585

# =============!!! WARNING !!!================
# MMC5XX3 natively has a left handed frame.
# I am not sure whether this was ignored in
# the driver or not.
# PLEASE VERIFY magnetic heading and update
# the above ROTATION_ for MMC5XX3 accordingly!
#
# Predicted solution:
# Throw in a negation somewhere in
# libraries/AP_Compass/AP_Compass_MMC5xx3.cpp
# search for read_register(REG_XOUT_L, ...)
# ============================================

define HAL_INS_HIGHRES_SAMPLE 3
define HAL_DEFAULT_INS_FAST_SAMPLE 3

# PWM outputs
PA5  TIM2_CH1 TIM2 PWM(1) GPIO(50) BIDIR
PA6  TIM3_CH1 TIM3 PWM(2) GPIO(51) BIDIR
PB0  TIM3_CH3 TIM3 PWM(3) GPIO(52) BIDIR
PB1  TIM3_CH4 TIM3 PWM(4) GPIO(53) BIDIR
#PE9  TIM1_CH1 TIM1 PWM(5) GPIO(54) BIDIR
#PE11 TIM1_CH2 TIM1 PWM(6) GPIO(55) BIDIR
#PE13 TIM1_CH3 TIM1 PWM(7) GPIO(56) BIDIR
#PE14 TIM1_CH4 TIM1 PWM(8) GPIO(57) BIDIR
